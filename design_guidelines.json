{
  "design_system": {
    "identity": {
      "name": "SushiMaster TV - Frosted Edition",
      "archetype": "Pastel & Soft (Archetype 3) + Glassmorphism",
      "vibe": "Airy, Sophisticated, Fluid, Organized",
      "core_principles": [
        "Fusion: macOS Tahoe aesthetics mixed with Japanese minimalism",
        "Depth: Heavy use of glassmorphism (blur + transparency) to create hierarchy",
        "Breathing Room: 2x standard spacing to feel premium",
        "Motion: Smooth, floating transitions (no abrupt cuts)"
      ]
    },
    "typography": {
      "font_family": {
        "headings": "Outfit, sans-serif",
        "body": "Manrope, sans-serif",
        "mono": "JetBrains Mono, monospace"
      },
      "scale": {
        "h1": "text-4xl md:text-5xl font-bold tracking-tight",
        "h2": "text-3xl font-semibold tracking-tight",
        "h3": "text-2xl font-medium",
        "body": "text-base leading-relaxed text-slate-600",
        "small": "text-sm font-medium text-slate-500"
      },
      "imports": [
        "@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Manrope:wght@400;500;600&display=swap');"
      ]
    },
    "colors": {
      "palette": {
        "background": {
          "main": "bg-slate-50",
          "gradient": "bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50"
        },
        "glass": {
          "panel": "bg-white/60 backdrop-blur-xl border border-white/40 shadow-sm",
          "card": "bg-white/40 backdrop-blur-md border border-white/50 shadow-sm hover:bg-white/50 transition-all duration-300",
          "overlay": "bg-white/80 backdrop-blur-md"
        },
        "primary": {
          "main": "bg-indigo-600",
          "hover": "hover:bg-indigo-700",
          "text": "text-indigo-600",
          "light": "bg-indigo-100 text-indigo-700"
        },
        "text": {
          "primary": "text-slate-800",
          "secondary": "text-slate-500",
          "muted": "text-slate-400"
        },
        "status": {
          "success": "text-emerald-600 bg-emerald-100/50 border-emerald-200",
          "error": "text-rose-600 bg-rose-100/50 border-rose-200",
          "warning": "text-amber-600 bg-amber-100/50 border-amber-200"
        }
      },
      "forbidden": [
        "#1B93A4 (Teal)",
        "#000000 (Pure Black)",
        "Dark Gradients for backgrounds"
      ]
    },
    "layout": {
      "spacing": {
        "container_padding": "p-6 md:p-10",
        "section_gap": "gap-8",
        "item_gap": "gap-4"
      },
      "radius": {
        "default": "rounded-2xl",
        "large": "rounded-3xl",
        "small": "rounded-xl"
      },
      "grid_strategy": "Bento Grid (Mode A) for Dashboard Overview, Dense Grid (Mode B) for Menu Lists"
    },
    "components": {
      "buttons": {
        "primary": "rounded-full bg-indigo-600 text-white hover:bg-indigo-700 shadow-lg shadow-indigo-200 transition-transform hover:scale-105 active:scale-95",
        "secondary": "rounded-full bg-white/50 text-slate-700 border border-white/60 hover:bg-white/80 backdrop-blur-sm",
        "ghost": "rounded-full hover:bg-slate-100/50 text-slate-600"
      },
      "cards": {
        "style": "glass-card",
        "classes": "rounded-3xl bg-white/40 backdrop-blur-xl border border-white/60 shadow-[0_8px_30px_rgb(0,0,0,0.04)]"
      },
      "inputs": {
        "style": "glass-input",
        "classes": "rounded-xl bg-white/50 border-white/60 focus:bg-white/80 focus:ring-2 focus:ring-indigo-200 transition-all placeholder:text-slate-400"
      }
    },
    "assets": {
      "images": {
        "backgrounds": [
          {
            "url": "https://images.unsplash.com/photo-1761888856976-c4bc8303f65f?crop=entropy&cs=srgb&fm=jpg&q=85",
            "category": "app-background",
            "description": "Soft orange/blue abstract shapes for main dashboard wallpaper"
          },
          {
            "url": "https://images.unsplash.com/photo-1761888857629-aa3f306f6bee?crop=entropy&cs=srgb&fm=jpg&q=85",
            "category": "login-background",
            "description": "Soft pink waves for login screen"
          }
        ],
        "products": [
          {
            "url": "https://images.unsplash.com/photo-1752095809329-5addd009f71d?crop=entropy&cs=srgb&fm=jpg&q=85",
            "category": "sushi-hero",
            "description": "Artistic sushi roll platter"
          },
          {
            "url": "https://images.unsplash.com/photo-1726824863833-e88146cf0a72?crop=entropy&cs=srgb&fm=jpg&q=85",
            "category": "sushi-list",
            "description": "Black plate with sushi assortment"
          }
        ],
        "locations": [
          {
            "url": "https://images.unsplash.com/photo-1601924334752-9056611bb684?crop=entropy&cs=srgb&fm=jpg&q=85",
            "category": "restaurant-interior",
            "description": "Modern restaurant seating"
          }
        ]
      },
      "icons": "lucide-react"
    },
    "motion": {
      "transitions": "transition-all duration-300 ease-out",
      "hover_effects": "hover:-translate-y-1 hover:shadow-lg",
      "page_transition": "animate-in fade-in slide-in-from-bottom-4 duration-500"
    }
  },
  "implementation_instructions": {
    "global_css": {
      "body": "Apply 'bg-slate-50' and the background image (url from assets) as a fixed cover with low opacity or as a pseudo-element to ensure text readability.",
      "glass_utility": ".glass { @apply bg-white/40 backdrop-blur-xl border border-white/60 shadow-sm; }"
    },
    "dashboard_layout": {
      "sidebar": "Fixed left, glassmorphism style. Use 'w-64 h-screen fixed left-0 top-0 glass z-50'.",
      "main_content": "ml-64 p-8 min-h-screen relative z-10"
    },
    "tv_display_mode": {
      "note": "For the 'Screen Display' page, ignore the pale theme if needed for contrast. Allow a 'Dark Mode' toggle or default to high-contrast dark glass (bg-slate-900/90) for better visibility on TVs.",
      "fullscreen": "w-screen h-screen overflow-hidden"
    },
    "shadcn_customization": {
      "radius": "0.75rem (12px) or 1rem (16px)",
      "border": "border-white/40",
      "popovers": "bg-white/80 backdrop-blur-xl"
    }
  },
  "universal_guidelines": [
    "Do not use generic 'Inter' font. Import 'Outfit' and 'Manrope'.",
    "Avoid solid white backgrounds for cards; always use semi-transparent white with backdrop-blur.",
    "Ensure text contrast is high (slate-800) since backgrounds are pale.",
    "Use 'sonner' for all notifications.",
    "All interactive elements must have 'data-testid'.",
    "Do not use 'transition: all'. Specify properties."
  ]
}